@vertex
fn vs_instanced(
    @builtin(vertex_index) vertex_idx: u32,
    @location(0) position: vec2<f32>,
    @location(1) uv_rect: vec4<f32>,
    @location(2) color: vec4<f32>,
    @location(3) scale: f32,
    @location(4) rotation: f32,
) -> InstancedVsOut {
    // 1. Get face tracking signals
    let face_pos_uv = S.v[0].xy;
    let face_roll = S.v[1].z;
    let face_scl = S.v[2].x;

    // 2. Map face position from UV space [0.0, 1.0] to NDC [-1.0, 1.0]
    var face_pos_ndc = face_pos_uv * vec2<f32>(2.0, -2.0) + vec2<f32>(-1.0, 1.0);
    if (P.mirror_x > 0.5) {
        face_pos_ndc.x = -face_pos_ndc.x;
    }
    if (P.mirror_y > 0.5) {
        face_pos_ndc.y = -face_pos_ndc.y;
    }

    let offset_ndc = vec2<f32>(P.offset_x, -P.offset_y);
    let face_pos = face_pos_ndc + offset_ndc;

    // 3. Compute final scale and rotation
    let rot_final = -face_roll + P.rotation_offset;
    let scl_final = face_scl * P.scale_mul;

    // 4. Generate local quad geometry scaled by glyph dimensions uv_rect.zw
    var pos_quad = array<vec2<f32>, 6>(
        vec2<f32>(-0.5, -0.5),
        vec2<f32>( 0.5, -0.5),
        vec2<f32>(-0.5,  0.5),
        vec2<f32>(-0.5,  0.5),
        vec2<f32>( 0.5, -0.5),
        vec2<f32>( 0.5,  0.5)
    );
    let local_pos = pos_quad[vertex_idx] * uv_rect.zw;

    // 5. Apply typographic instance scale & position
    let glyph_offset = local_pos * scale + position;

    // 6. Apply dynamic face tracking rotation and scale
    let cos_f = cos(rot_final);
    let sin_f = sin(rot_final);
    let rotated_offset = vec2<f32>(
        glyph_offset.x * cos_f - glyph_offset.y * sin_f,
        glyph_offset.x * sin_f + glyph_offset.y * cos_f
    ) * (scl_final * 15.0);

    let final_pos = face_pos + rotated_offset;

    var out: InstancedVsOut;
    out.clip = vec4<f32>(final_pos, 0.0, 1.0);

    var uv_corners = array<vec2<f32>, 6>(
        vec2<f32>(0.0, 0.0),
        vec2<f32>(1.0, 0.0),
        vec2<f32>(0.0, 1.0),
        vec2<f32>(0.0, 1.0),
        vec2<f32>(1.0, 0.0),
        vec2<f32>(1.0, 1.0)
    );
    out.uv = uv_corners[vertex_idx];
    out.color = color;
    out.char_id = u32(round(uv_rect.x));

    return out;
}

fn get_atlas_pixel(px: u32, py: u32) -> f32 {
    let byte_idx = py * 128u + px;
    let u32_idx = byte_idx / 4u;
    let byte_offset = byte_idx % 4u;
    let word = ATLAS_DATA[u32_idx];
    let val = (word >> (byte_offset * 8u)) & 0xffu;
    return f32(val) / 255.0;
}

fn sample_atlas_bilinear(char_id: u32, uv: vec2<f32>) -> f32 {
    let cell_x = f32(char_id % 8u);
    let cell_y = f32(char_id / 8u);
    
    // Local coordinate inside the cell: goes from 0.5 to 15.5
    let local_coord = uv * 16.0 - vec2<f32>(0.5);
    let tc_floor = floor(local_coord);
    let tc_frac = local_coord - tc_floor;
    
    let x0 = u32(clamp(tc_floor.x, 0.0, 15.0));
    let x1 = u32(clamp(tc_floor.x + 1.0, 0.0, 15.0));
    let y0 = u32(clamp(tc_floor.y, 0.0, 15.0));
    let y1 = u32(clamp(tc_floor.y + 1.0, 0.0, 15.0));
    
    let cell_offset_x = u32(cell_x) * 16u;
    let cell_offset_y = u32(cell_y) * 16u;
    
    let p00 = get_atlas_pixel(cell_offset_x + x0, cell_offset_y + y0);
    let p10 = get_atlas_pixel(cell_offset_x + x1, cell_offset_y + y0);
    let p01 = get_atlas_pixel(cell_offset_x + x0, cell_offset_y + y1);
    let p11 = get_atlas_pixel(cell_offset_x + x1, cell_offset_y + y1);
    
    let p0 = mix(p00, p10, tc_frac.x);
    let p1 = mix(p01, p11, tc_frac.x);
    return mix(p0, p1, tc_frac.y);
}

@fragment
fn fs_main(in: InstancedVsOut) -> @location(0) vec4<f32> {
    let face_scl = S.v[2].x;
    let presence = smoothstep(0.01, 0.04, face_scl);
    let alpha_mul = P.opacity * presence;

    if (alpha_mul <= 0.001) {
        discard;
    }

    let sdf = sample_atlas_bilinear(in.char_id, in.uv);
    let dist = 0.5 - sdf;

    let edge = fwidth(dist);
    let alpha = smoothstep(edge, -edge, dist);

    if (alpha <= 0.01) {
        discard;
    }

    return vec4<f32>(in.color.rgb, in.color.a * alpha * alpha_mul);
}
